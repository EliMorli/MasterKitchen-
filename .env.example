# Supabase — required
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# WhatsApp Cloud API — optional.
# Leave unset and the app runs in manual mode: it writes the exact message and
# you send it with one tap. Set both to switch on automatic sending. Group
# messaging additionally needs an Official Business Account, and the number
# cannot be on the WhatsApp Business app. See docs/07-communications.md.
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_API_VERSION=v21.0
